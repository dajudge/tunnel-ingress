{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cloudflareDdns": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "dryRun",
          "zoneId",
          "recordId",
          "recordName",
          "tokenSecret"
        ],
        "properties": {
          "zoneId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "recordId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "recordName": {
            "type": "string",
            "minLength": 1
          },
          "tokenSecret": {
            "type": "object",
            "required": [
              "name",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
